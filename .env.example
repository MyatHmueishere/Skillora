# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase project URL (configured in AI Studio Secrets).
SUPABASE_URL="MY_SUPABASE_URL"

# SUPABASE_PUBLISHABLE_KEY: Your Supabase public publishable/anon key (configured in AI Studio Secrets).
SUPABASE_PUBLISHABLE_KEY="MY_SUPABASE_PUBLISHABLE_KEY"

# YOUTUBE_API_KEY: Optional server-only YouTube Data API v3 key for live educational video lookup.
# When omitted, Skillora automatically uses its verified oEmbed-checked educational video registry.
# YOUTUBE_API_KEY="MY_YOUTUBE_API_KEY"

# SUPABASE_SERVICE_ROLE_KEY: Optional server-only service role key used by scheduled background
# notification dispatch jobs to evaluate inactive learners across accounts. Never expose to frontend.
# SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# Web Push VAPID Keys (generate with `npx web-push generate-vapid-keys`).
# VAPID_PRIVATE_KEY must stay strictly server-side; never put it in VITE_* variables.
# VAPID_PUBLIC_KEY="MY_VAPID_PUBLIC_KEY"
# VAPID_PRIVATE_KEY="MY_VAPID_PRIVATE_KEY"
# VAPID_SUBJECT="mailto:support@skillora.app"

# CRON_SECRET: Optional secret header/Bearer token protecting POST /api/notifications/dispatch-scheduled.
# CRON_SECRET="MY_CRON_SECRET"


